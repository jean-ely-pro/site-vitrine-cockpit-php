{
    "name": "site-vitrine/front",
    "description": "Site vitrine rendu côté serveur, alimenté par Cockpit",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "twig/twig": "^3.28",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "PasswordPolicy\\": "cockpit/addons/PasswordPolicy/",
            "EditorGuards\\": "cockpit/addons/EditorGuards/",
            "Media\\": "cockpit/addons/Media/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "install-cockpit": "@php bin/install-cockpit.php",
        "init-cockpit": "@php bin/cockpit-init.php",
        "serve": "@php -S localhost:8080 -t public public/index.php",
        "serve-admin": "@php -S localhost:8090 -t public/admin public/admin/index.php",
        "test": "phpunit",
        "verifier": "@php bin/verifier-accessibilite.php"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.50"
    }
}
