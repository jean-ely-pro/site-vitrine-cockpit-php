{
    "name": "site-vitrine/front",
    "description": "Site vitrine rendu côté serveur, alimenté par Cockpit",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "twig/twig": "^3.28",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "install-cockpit": "@php bin/install-cockpit.php",
        "init-cockpit": "@php bin/cockpit-init.php",
        "serve": "@php -S localhost:8080 -t public",
        "serve-admin": "@php -S localhost:8090 -t public/admin public/admin/index.php"
    }
}
