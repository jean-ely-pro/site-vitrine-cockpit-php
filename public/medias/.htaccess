# Media sent from the administration are served from here.
#
# The folder holds nothing but files a customer uploaded, so it is readable
# from outside — and nothing else is. Cockpit already refuses executable files
# on upload, by extension and by MIME type; the rule below is the second
# barrier, and it holds even for a file that arrived by another route.

Options -Indexes

<IfModule mod_authz_core.c>
    Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
    Allow from all
</IfModule>

<FilesMatch "(?i)\.(php[0-9s]?|phtml|phar|cgi|pl|py|sh|htaccess|htpasswd)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>
