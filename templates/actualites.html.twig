{% extends 'base.html.twig' %}

{% set categories = {
    'actualite': 'Actualité',
    'evenement': 'Événement',
    'conseil': 'Conseil'
} %}

{% block title %}Actualités{% if site.nom %} — {{ site.nom }}{% endif %}{% endblock %}

{% block head %}
    <meta name="description" content="Les dernières actualités{% if site.nom %} de {{ site.nom }}{% endif %}.">
    {# Nothing published yet: the page stays reachable, but has nothing to index. #}
    {% if articles is empty %}<meta name="robots" content="noindex">{% endif %}
{% endblock %}

{% block main %}
    <h1 class="page__titre">Actualités</h1>

    {% if articles is empty %}
        <p>Aucune actualité pour le moment.</p>
    {% else %}
        <ul class="actualites">
            {% for article in articles %}
                {% set image = media_url(article.image) %}
                <li class="actualite-resume">

                    {% if image %}
                        <a href="/actualites/{{ article.slug }}" tabindex="-1" aria-hidden="true">
                            <img class="actualite-resume__image"
                                 src="{{ image }}"
                                 alt=""
                                 {% if article.image.width %}width="{{ article.image.width }}"{% endif %}
                                 {% if article.image.height %}height="{{ article.image.height }}"{% endif %}
                                 loading="lazy"
                                 decoding="async">
                        </a>
                    {% endif %}

                    <div class="actualite-resume__texte">
                        <p class="actualite__meta">
                            {% if article.date %}
                                <time datetime="{{ article.date }}">{{ article.date|date('d/m/Y') }}</time>
                            {% endif %}
                            {% if article.categorie %}
                                <span class="actualite__categorie">{{ categories[article.categorie]|default(article.categorie) }}</span>
                            {% endif %}
                        </p>

                        <h2><a href="/actualites/{{ article.slug }}">{{ article.titre }}</a></h2>

                        {% if article.resume %}
                            <p>{{ article.resume }}</p>
                        {% endif %}
                    </div>

                </li>
            {% endfor %}
        </ul>
    {% endif %}
{% endblock %}
