{# Contact form.

   Posts to the site itself — nothing leaves for a third party, no captcha
   service, no remote script. What guards it: a field no one sees, the time
   taken to fill the form, and a limit per address.

   Not offered at all when the write key is missing: better no form than one
   that silently loses messages. #}

{% set valeurs = formulaire.valeurs|default({}) %}
{% set champs = formulaire.champs|default({}) %}
{% set envoye = formulaire.envoye|default(false) %}

<section class="bloc bloc-formulaire" id="formulaire">

    {% if titre %}
        <h{{ niveau }}>{{ titre }}</h{{ niveau }}>
    {% endif %}

    {% if bloc.texte %}
        {# Rich text produced by the admin editor: intentionally not escaped. #}
        {{ bloc.texte|raw }}
    {% endif %}

    {% if envoye %}
        <p class="message message--succes" role="status">
            Message envoyé. Nous répondons sous deux jours ouvrés.
        </p>
    {% endif %}

    {% if not contactActif|default(false) %}

        {# Configuration missing: fall back on the details, which always work. #}
        <ul class="bloc-contact__coordonnees">
            {% if site.telephone %}
                <li><a href="tel:{{ tel_href(site.telephone) }}">{{ site.telephone }}</a></li>
            {% endif %}
            {% if site.email %}
                <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
            {% endif %}
        </ul>

    {% else %}

        {% if formulaire.erreur is defined %}
            <p class="message message--erreur" role="alert">{{ formulaire.erreur }}</p>
        {% endif %}

        <form class="formulaire" method="post" action="/contact" novalidate>

            <input type="hidden" name="jeton" value="{{ jetonContact }}">
            <input type="hidden" name="retour" value="{{ slug == accueilSlug|default('accueil') ? '/' : '/' ~ slug }}">

            {# Left empty by anyone who can see it. Hidden from assistive
               technologies too, so it is never announced. #}
            <div class="formulaire__piege" aria-hidden="true">
                <label for="site_web">Ne pas remplir ce champ</label>
                <input type="text" id="site_web" name="site_web" tabindex="-1" autocomplete="off">
            </div>

            <p class="formulaire__champ">
                <label for="contact-nom">Votre nom</label>
                <input type="text" id="contact-nom" name="nom" required autocomplete="name"
                       value="{{ valeurs.nom|default('') }}"
                       {% if champs.nom is defined %}aria-invalid="true" aria-describedby="erreur-nom"{% endif %}>
                {% if champs.nom is defined %}
                    <span class="formulaire__erreur" id="erreur-nom">{{ champs.nom }}</span>
                {% endif %}
            </p>

            <p class="formulaire__champ">
                <label for="contact-email">Votre adresse e-mail</label>
                <input type="email" id="contact-email" name="email" required autocomplete="email"
                       value="{{ valeurs.email|default('') }}"
                       {% if champs.email is defined %}aria-invalid="true" aria-describedby="erreur-email"{% endif %}>
                {% if champs.email is defined %}
                    <span class="formulaire__erreur" id="erreur-email">{{ champs.email }}</span>
                {% endif %}
            </p>

            <p class="formulaire__champ">
                <label for="contact-message">Votre message</label>
                <textarea id="contact-message" name="message" rows="6" required
                          {% if champs.message is defined %}aria-invalid="true" aria-describedby="erreur-message"{% endif %}>{{ valeurs.message|default('') }}</textarea>
                {% if champs.message is defined %}
                    <span class="formulaire__erreur" id="erreur-message">{{ champs.message }}</span>
                {% endif %}
            </p>

            <p class="formulaire__consentement">
                {# Never checked in advance: consent that was not given by the
                   person is not consent. #}
                <input type="checkbox" id="contact-consentement" name="consentement" value="1"
                       {% if champs.consentement is defined %}aria-invalid="true" aria-describedby="erreur-consentement"{% endif %}>
                <label for="contact-consentement">
                    J’accepte que mon nom et mon adresse e-mail soient conservés pour répondre à ce
                    message.
                    {% if bloc.pageConfidentialite.slug is defined %}
                        <a href="/{{ bloc.pageConfidentialite.slug }}">Politique de confidentialité</a>.
                    {% endif %}
                </label>
                {% if champs.consentement is defined %}
                    <span class="formulaire__erreur" id="erreur-consentement">{{ champs.consentement }}</span>
                {% endif %}
            </p>

            <p><button type="submit" class="bouton">Envoyer le message</button></p>

        </form>

    {% endif %}

</section>
