# Copier ce fichier en .env — jamais versionné.

# dev : erreurs détaillées, cache de gabarits désactivé. prod : l'inverse.
APP_ENV=dev

# Adresse de l'API de contenu de Cockpit.
#   développement : http://localhost:8081/api
#   production    : https://domaine-du-client.tld/admin/api
COCKPIT_API_URL=http://localhost:8081/api

# Clé de lecture, générée par « php bin/cockpit-init.php ».
# Elle n'autorise que la lecture du contenu publié.
COCKPIT_API_KEY=

# Slug de la page servie à l'adresse racine du site.
HOME_PAGE_SLUG=accueil
