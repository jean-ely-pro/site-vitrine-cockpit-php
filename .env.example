# Copier ce fichier en .env — jamais versionné.

# dev : erreurs détaillées, cache de gabarits désactivé. prod : l'inverse.
APP_ENV=dev

# Adresse publique du site, sans barre oblique finale.
# Sert au plan du site et aux données structurées, qui exigent des adresses
# complètes. Vide, l'adresse de la requête est utilisée.
SITE_URL=http://localhost:8080

# Adresse de l'API de contenu de Cockpit.
#   développement : http://localhost:8090/api  (port du serveur d'administration)
#   production    : https://domaine-du-client.tld/admin/api
COCKPIT_API_URL=http://localhost:8090/api

# Clé de lecture, générée par « php bin/cockpit-init.php ».
# Elle n'autorise que la lecture du contenu publié.
COCKPIT_API_KEY=

# Clé d'écriture du formulaire de contact, générée par le même script.
# Elle n'autorise qu'une chose : déposer un message reçu. Sans elle, le
# formulaire n'est pas affiché et les coordonnées le remplacent.
COCKPIT_WRITE_KEY=

# Où sont servies les images envoyées depuis l'administration. Cette adresse
# sert au site pour ses pages, et à l'administration pour ses aperçus.
#   développement : http://localhost:8080/medias  (port du site, pas de l'admin)
#   production    : /medias
MEDIA_BASE_URL=http://localhost:8080/medias

# Slug de la page servie à l'adresse racine du site.
HOME_PAGE_SLUG=accueil

# Cache de pages : le HTML rendu est écrit dans public/cache et servi
# directement par Apache, sans démarrer PHP. Vide, il suit APP_ENV — actif en
# production, inactif en développement pour voir ses modifications tout de
# suite. Mettre « true » pour le tester en local.
PAGE_CACHE=
